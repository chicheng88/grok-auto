# freemail / cloudflare_temp_email
# WORKER_DOMAIN 不要带 https://
WORKER_DOMAIN=your-worker.workers.dev
# cloudflare_temp_email 填站点密码；旧 freemail 填 JWT
FREEMAIL_TOKEN=your-password-or-jwt
# 邮箱后缀：auto=服务端默认；单域名；或多域名逗号分隔（建邮 round-robin）
# 例: auto  或  example.com  或  a.example.com,b.example.com
FREEMAIL_DOMAIN=auto
# auto | cf_temp | freemail
FREEMAIL_API_STYLE=auto

# Turnstile
# 不填 YESCAPTCHA_KEY 则使用本地 Solver
YESCAPTCHA_KEY=
SOLVER_URL=http://127.0.0.1:5072
SOLVER_BROWSER=camoufox
# 建议 4~8，与注册并发匹配
SOLVER_THREADS=4
SOLVER_HOST=127.0.0.1
SOLVER_PORT=5072
SOLVER_DEBUG=0
# SSO 后后台换 token / NSFW 等线程
ENRICH_WORKERS=12

# Web 控制台
UI_HOST=127.0.0.1
UI_PORT=3333

# 注册代理（空=直连）
# 格式: host:port | http://host:port | socks5://host:port
#       user:pass@host:port | host:port:user:pass
GROK_PROXY=
# 代理池（优先）：多行用分号写在一行，或控制台「代理」页多行粘贴后保存
# 例: 127.0.0.1:7897;socks5://user:pass@host:1080
GROK_PROXY_LIST=

# same_session 熔断（deny / risk MARKED）
# 单出口连续 MARKED 停批；0=关
GROK_SS_DENY_BREAK=3
# 多代理时：deny 后连续切代理次数上限，触顶进入冷却；0=不切代理
GROK_SS_PROXY_SWITCH_LIMIT=3
# 冷却秒数（到点自动继续）
GROK_SS_COOLDOWN_SEC=60
# 指纹按出口国家簇对齐：1=开（推荐）0=全球轮（仅调试）
GROK_SS_FP_ALIGN=1

# ---------- sub2api（HTTP 导入）----------
# 根地址，不要末尾 /
SUB2API_URL=http://127.0.0.1:9898
# 只填分组名称；ID 可留空，程序按名称自动解析并回写
SUB2API_GROK_GROUP_NAME=grok
SUB2API_GROK_GROUP_ID=
# 管理员账号（仅本地 .env，勿提交真实密码）
UPSTREAM_URL=http://127.0.0.1:9898
UPSTREAM_ADMIN_EMAIL=admin@example.com
UPSTREAM_ADMIN_PASSWORD=your-admin-password
